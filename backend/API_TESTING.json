{
  "info": {
    "name": "Recipe API Testing",
    "description": "Postman collection for testing Recipe Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CATEGORIES",
      "item": [
        {
          "name": "GET all categories",
          "request": {
            "method": "GET",
            "url": "http://localhost:3000/api/categories"
          }
        },
        {
          "name": "POST create category",
          "request": {
            "method": "POST",
            "url": "http://localhost:3000/api/categories",
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Desserts\"}"
            },
            "header": {
              "Content-Type": "application/json"
            }
          }
        },
        {
          "name": "POST create category - ERROR (missing name)",
          "request": {
            "method": "POST",
            "url": "http://localhost:3000/api/categories",
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "header": {
              "Content-Type": "application/json"
            }
          }
        },
        {
          "name": "GET one category by ID",
          "request": {
            "method": "GET",
            "url": "http://localhost:3000/api/categories/{categoryId}"
          }
        },
        {
          "name": "PUT update category",
          "request": {
            "method": "PUT",
            "url": "http://localhost:3000/api/categories/{categoryId}",
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Desserts Updated\"}"
            },
            "header": {
              "Content-Type": "application/json"
            }
          }
        },
        {
          "name": "DELETE category",
          "request": {
            "method": "DELETE",
            "url": "http://localhost:3000/api/categories/{categoryId}"
          }
        }
      ]
    },
    {
      "name": "RECIPES",
      "item": [
        {
          "name": "GET all recipes",
          "request": {
            "method": "GET",
            "url": "http://localhost:3000/api/recettes"
          }
        },
        {
          "name": "POST create recipe",
          "request": {
            "method": "POST",
            "url": "http://localhost:3000/api/recettes",
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Pâtes Carbonara\", \"description\": \"Pâtes avec œufs, bacon et parmesan\", \"difficulty\": \"facile\", \"category\": \"{categoryId}\", \"ingredients\": [\"Pâtes\", \"Œufs\", \"Bacon\", \"Parmesan\"]}"
            },
            "header": {
              "Content-Type": "application/json"
            }
          }
        },
        {
          "name": "POST create recipe - ERROR (missing description)",
          "request": {
            "method": "POST",
            "url": "http://localhost:3000/api/recettes",
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Pâtes\", \"difficulty\": \"facile\", \"category\": \"{categoryId}\"}"
            },
            "header": {
              "Content-Type": "application/json"
            }
          }
        },
        {
          "name": "GET one recipe by ID",
          "request": {
            "method": "GET",
            "url": "http://localhost:3000/api/recettes/{recetteId}"
          }
        },
        {
          "name": "PUT update recipe",
          "request": {
            "method": "PUT",
            "url": "http://localhost:3000/api/recettes/{recetteId}",
            "body": {
              "mode": "raw",
              "raw": "{\"difficulty\": \"moyen\", \"ingredients\": [\"Pâtes\", \"Œufs\", \"Bacon\", \"Parmesan\", \"Poivre\"]}"
            },
            "header": {
              "Content-Type": "application/json"
            }
          }
        },
        {
          "name": "DELETE recipe",
          "request": {
            "method": "DELETE",
            "url": "http://localhost:3000/api/recettes/{recetteId}"
          }
        }
      ]
    }
  ]
}
